<?xml version="1.0" encoding="utf-8"?>
<!--
  TV flavor 覆盖（2026-11-07 P0）。
  与 src/main/AndroidManifest.xml 合并：保留原有权限、usesCleartextTraffic、
  LaunchTheme、configChanges、Flutter 元数据；这里只补 TV 专属声明。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 海尔 HRA972_TX_A 无触摸屏；不声明 optional 会让系统按触屏设备处理 -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="true"/>

    <application
        android:label="剧播 TV"
        android:banner="@drawable/tv_banner"
        tools:replace="android:label">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <!-- 海尔自研桌面通常只认 LAUNCHER -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Leanback / Android TV 桌面认 LEANBACK_LAUNCHER -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
